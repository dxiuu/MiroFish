# ===== LLM API Configuration =====
# Supports any OpenAI-compatible API (Gemini, Qwen, OpenAI, etc.)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_NAME=gemini-3.1-flash-lite-preview

# Fallback model used if primary returns 503 (optional)
LLM_FALLBACK_MODEL=gemini-2.5-flash-lite

# ===== Graph Backend =====
# Options: graphiti (self-hosted Neo4j) or zep
GRAPH_BACKEND=graphiti

# ===== Graphiti + Neo4j (required when GRAPH_BACKEND=graphiti) =====
# Start Neo4j with: docker compose -f docker-compose.neo4j.yml up -d
GRAPHITI_NEO4J_URI=bolt://localhost:7687
GRAPHITI_NEO4J_USER=neo4j
GRAPHITI_NEO4J_PASSWORD=your_neo4j_password_here
GRAPHITI_EMBEDDER_MODEL=models/gemini-embedding-001

# ===== Zep (required when GRAPH_BACKEND=zep) =====
# Self-hosted: docker compose -f docker-compose.zep.yml up -d
ZEP_API_URL=http://localhost:8000
# Zep Cloud (alternative to self-hosted):
# ZEP_API_KEY=your_zep_api_key_here

# ===== Boost LLM (optional, for high-throughput tasks) =====
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
